{
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "prisma": "^7.4.0"
  },
  "dependencies": {
    "@prisma/client": "^7.4.1",
    "@tanstack/react-query": "^5.90.21",
    "react-router": "^7.13.0"
  },
  "name": "gym-planner-workspace",
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../mobile && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:mobile": "cd mobile && npm start",
    "dev:web": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "web": "npm run dev:web",
    "start": "concurrently \"npm run dev:backend\" \"npm run dev:mobile\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DominikaBomba/WebApplicationGymPlanner.git"
